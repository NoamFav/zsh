# AI model interaction
alias llama3='llama-cli -hf unsloth/Llama-3.3-70B-Instruct-GGUF'

# Apple Music controls (macOS AppleScript)
alias mm="osascript -e 'tell application \"Music\" to playpause'"      # Play/Pause
alias mn="osascript -e 'tell application \"Music\" to next track'"     # Next track
alias mp="osascript -e 'tell application \"Music\" to previous track'" # Previous track

# Network games
alias starwars='ssh starwarstel.net'    # Star Wars MUD
alias idle='pipes.sh -p 10 -t 9 -r 100000 -R'
