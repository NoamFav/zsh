# Check git status for all repositories with colored output
gitcheck() {
    local GREEN="\033[0;32m"
    local RED="\033[0;31m"
    local BLUE="\033[0;34m"
    local GRAY="\033[0;90m"
    local BOLD="\033[1m"
    local RESET="\033[0m"

    local dirs=("$@")
    # Default to checking main development directories
    if [ ${#dirs[@]} -eq 0 ]; then
        dirs=(~/Neoware/*/ ~/.config/*/)
    fi

    echo -e "${BOLD}${BLUE}🔍 Checking git status...${RESET}\n"

    for dir in "${dirs[@]}"; do
        clean_path="${dir%/}"                    # Remove trailing slash
        clean_path="${clean_path/#$HOME\//~/}"   # Replace $HOME with ~

        if [[ -d "$dir/.git" ]]; then
            if git -C "$dir" status --porcelain 2>/dev/null | grep -q .; then
                printf "%-40s %b\n" "$clean_path" "${RED}🔴 uncommitted changes${RESET}"
            else
                printf "%-40s %b\n" "$clean_path" "${GREEN}✅ clean${RESET}"
            fi
        else
            printf "%-40s %b\n" "$clean_path" "${GRAY}📁 not a git repo${RESET}"
        fi
    done
}

# GitHub email correction utility with interactive selection
gh-fix-email() {
    echo "📧 GitHub Email Fixer - Select repository to fix commit emails"
    gh repo list noamfav --limit 1000 --json nameWithOwner --jq '.[].nameWithOwner' | \
        fzf --prompt="🔧 Fix emails for: " \
            --preview 'echo "📜 Recent commits for {}:"; cd "$(basename {})" 2>/dev/null && git log --pretty="%h %an <%ae>" | head -10 || echo "Repository not found locally"' \
            --preview-window=right:70% \
            --border=rounded \
            --bind "enter:execute(
                echo \"🔧 Fixing emails for {}...\";
                cd \"\$(basename {})\" || exit;
                git filter-repo --commit-callback '
                    old_emails = [b\"REDACTED\", b\"REDACTED\", b\"REDACTED\"]
                    correct_name = b\"NoamFav\"
                    correct_email = b\"95364866+NoamFav@users.noreply.github.com\"
                    if commit.committer_email in old_emails:
                        commit.committer_name = correct_name
                        commit.committer_email = correct_email
                    if commit.author_email in old_emails:
                        commit.author_name = correct_name
                        commit.author_email = correct_email
                ' --force;
                git remote add origin https://github.com/{} 2>/dev/null;
                git push origin main --force;
                echo \"✅ Email fix completed for {}\";
            )"
}

